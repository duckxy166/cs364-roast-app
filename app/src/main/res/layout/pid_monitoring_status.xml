<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/pid_monitoring_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/pid_tonal_panel" android:padding="16dp" android:layout_marginTop="20dp" android:visibility="gone" android:accessibilityLiveRegion="polite">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/pid_monitor_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/pid_ic_permission" app:tint="@color/pid_error" android:importantForAccessibility="no" />
        <TextView android:id="@+id/pid_monitor_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/pid_monitor_missing" android:textAppearance="@style/TextAppearance.PutItDown.Body" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/pid_monitor_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/pid_monitor_missing_desc" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_nav_onboarding" style="@style/Widget.PutItDown.Button.Secondary" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/pid_monitor_check" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pid_monitor_settings" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_monitor_settings" android:visibility="gone" app:icon="@null" />
</LinearLayout>