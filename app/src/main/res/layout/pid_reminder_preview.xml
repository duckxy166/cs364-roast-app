<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
    <TextView android:id="@+id/pid_preview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_preview_title" android:textAppearance="@style/TextAppearance.PutItDown.Section" />
    <TextView android:id="@+id/pid_preview_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_preview_note" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginTop="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="20dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_level_1" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/pid_preview_level_1" style="@style/Widget.PutItDown.Button.Secondary" android:layout_weight="1" android:layout_marginEnd="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_level_2" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/pid_preview_level_2" style="@style/Widget.PutItDown.Button.Secondary" android:layout_weight="1" android:layout_marginEnd="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:textSize="12sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_level_3" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/pid_preview_level_3" style="@style/Widget.PutItDown.Button.Secondary" android:layout_weight="1" android:layout_marginEnd="4dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:minWidth="0dp" android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/pid_card_background" android:padding="18dp" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="18dp" android:layout_height="18dp" android:src="@drawable/pid_ic_notification" app:tint="@color/pid_secondary" android:importantForAccessibility="no" />
            <TextView android:id="@+id/pid_preview_app" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/app_name" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginStart="8dp" android:layout_weight="1" />
        </LinearLayout>
        <TextView android:id="@+id/pid_preview_notification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/roast_level1_title" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/pid_preview_notification_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_preview_1" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:layout_marginTop="8dp" />
    </LinearLayout>
    <TextView android:id="@+id/pid_preview_delivery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_preview_delivery_1" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginTop="16dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_close" style="@style/Widget.PutItDown.Button.Back" android:layout_marginTop="12dp" />
</LinearLayout>