<?xml version='1.0' encoding='utf-8'?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
  <com.google.android.material.navigationrail.NavigationRailView
      android:id="@+id/pid_bottom_nav"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:background="@color/pid_surface"
      app:menu="@menu/pid_navigation"
      app:labelVisibilityMode="labeled"
      app:itemIconTint="@color/pid_nav_icon"
      app:itemTextColor="@color/pid_nav_content"
      app:itemActiveIndicatorStyle="@style/Widget.PutItDown.NavigationIndicator"
      app:itemTextAppearanceActive="@style/TextAppearance.PutItDown.Nav"
      app:itemTextAppearanceInactive="@style/TextAppearance.PutItDown.Nav"
      app:itemIconSize="22dp"
      app:elevation="0dp" />
</FrameLayout>