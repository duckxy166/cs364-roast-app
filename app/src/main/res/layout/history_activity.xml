<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/pid_background">
  <include android:id="@+id/pid_navigation" layout="@layout/pid_navigation" android:layout_width="0dp" android:layout_height="wrap_content" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
  <androidx.core.widget.NestedScrollView android:id="@+id/pid_scroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintBottom_toTopOf="@id/pid_navigation" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="8dp" android:paddingBottom="32dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="560dp">

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_history_back" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="-12dp" android:text="@string/pid_back" />
        <TextView android:id="@+id/text_history_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/history_title" android:textAppearance="@style/TextAppearance.PutItDown.Heading" />
        <TextView android:id="@+id/text_history_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_subtitle" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:visibility="gone" />

        <!-- Weekly usage: range as the caption, the total as the hero, chart underneath. -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="@string/history_weekly_section" android:textAppearance="@style/TextAppearance.PutItDown.GroupLabel" />
        <com.google.android.material.card.MaterialCardView style="@style/Widget.PutItDown.Card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/history_date_range" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <TextView android:id="@+id/text_history_weekly_total" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/review_usage_loading" android:textAppearance="@style/TextAppearance.PutItDown.Section" android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/history_usage_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <com.cs364.roastapp.history.WeeklyChartView android:id="@+id/chart_history_weekly" android:layout_width="match_parent" android:layout_height="148dp" android:layout_marginTop="8dp" android:importantForAccessibility="no" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/review_usage_scope" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <com.google.android.material.button.MaterialButton android:id="@+id/history_daily_toggle" style="@style/Widget.PutItDown.Button.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:text="@string/review_daily_show" />
            <LinearLayout android:id="@+id/history_daily_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
            <com.google.android.material.button.MaterialButton android:id="@+id/history_usage_action" style="@style/Widget.PutItDown.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/review_usage_retry" android:visibility="gone" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
          <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/history_events_section" android:textAppearance="@style/TextAppearance.PutItDown.GroupLabel" />
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_history_clear_all" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_clear_all_btn" android:textColor="@color/pid_error" app:icon="@null" />
        </LinearLayout>

        <LinearLayout android:id="@+id/layout_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/pid_card_background" android:padding="16dp">
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_empty" android:textAppearance="@style/TextAppearance.PutItDown.Body" />
          <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/review_history_empty_note" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
          <com.google.android.material.button.MaterialButton android:id="@+id/history_empty_apps" style="@style/Widget.PutItDown.Button.Link" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingStart="0dp" android:text="@string/review_choose_apps" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_history_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" />
      </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
