<?xml version="1.0" encoding="utf-8"?>
<!-- App picker shown in a bottom sheet (AppLimitsUi.showPicker). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="24dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="24dp" android:paddingEnd="24dp" android:text="@string/pid_choose_app" android:textAppearance="@style/TextAppearance.PutItDown.Section" />
    <com.google.android.material.textfield.TextInputLayout style="@style/Widget.PutItDown.TextField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="24dp" android:layout_marginEnd="24dp" android:layout_marginTop="16dp" android:layout_marginBottom="8dp" app:hintEnabled="false">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/pid_picker_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="@string/pid_search_apps" android:inputType="text" android:maxLines="1" android:textAppearance="@style/TextAppearance.PutItDown.Body" />
    </com.google.android.material.textfield.TextInputLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/pid_picker_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp" />
    </ScrollView>
</LinearLayout>