<?xml version='1.0' encoding='utf-8'?>
<resources>
  <style name="ShapeAppearance_PutItDown" parent="">
    <item name="cornerFamily">rounded</item>
    <item name="cornerSize">@dimen/pid_card_radius</item>
  </style>
  <style name="TextAppearance.PutItDown.Body" parent="TextAppearance.Material3.BodyLarge">
    <item name="fontFamily">@font/pid_ui</item>
    <item name="android:fontFamily">@font/pid_ui</item>
    <item name="android:textSize">@dimen/pid_type_body</item>
    <item name="android:textColor">@color/pid_on_surface</item>
  </style>
  <style name="TextAppearance.PutItDown.Heading" parent="TextAppearance.PutItDown.Body">
    <item name="android:textSize">@dimen/pid_type_heading</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="TextAppearance.PutItDown.Section" parent="TextAppearance.PutItDown.Body">
    <item name="android:textSize">@dimen/pid_type_section</item>
    <item name="android:textStyle">bold</item>
  </style>
  <style name="TextAppearance.PutItDown.Label" parent="TextAppearance.PutItDown.Body">
    <item name="android:textSize">@dimen/pid_type_label</item>
  </style>
  <style name="TextAppearance.PutItDown.Supporting" parent="TextAppearance.PutItDown.Body">
    <item name="android:textSize">@dimen/pid_type_supporting</item>
    <item name="android:textColor">@color/pid_on_surface_variant</item>
  </style>
  <style name="TextAppearance.PutItDown.Timer" parent="TextAppearance.PutItDown.Heading">
    <item name="android:textSize">@dimen/pid_type_timer</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>
  <style name="Widget.PutItDown.Button.Primary" parent="Widget.Material3.Button">
    <item name="android:minHeight">@dimen/pid_primary_height</item>
    <item name="android:textAppearance">@style/TextAppearance.PutItDown.Label</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textAllCaps">false</item>
    <item name="backgroundTint">@color/pid_primary_background</item>
    <item name="android:textColor">@color/pid_primary_text</item>
    <item name="iconTint">@color/pid_primary_text</item>
    <item name="cornerRadius">@dimen/pid_button_radius</item>
    <item name="iconSize">@dimen/pid_icon_size</item>
  </style>
  <style name="Widget.PutItDown.Button.Secondary" parent="Widget.Material3.Button.OutlinedButton">
    <item name="android:minHeight">@dimen/pid_touch_target</item>
    <item name="android:textAppearance">@style/TextAppearance.PutItDown.Label</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/pid_on_surface</item>
    <item name="iconTint">@color/pid_on_surface</item>
    <item name="strokeColor">@color/pid_outline_variant</item>
    <item name="cornerRadius">@dimen/pid_button_radius</item>
    <item name="iconSize">@dimen/pid_icon_size</item>
  </style>
  <style name="Widget.PutItDown.Button.Destructive" parent="Widget.PutItDown.Button.Secondary">
    <item name="android:textColor">@color/pid_error</item>
    <item name="iconTint">@color/pid_error</item>
  </style>
  <style name="Widget.PutItDown.Button.Back" parent="Widget.Material3.Button.TextButton">
    <item name="android:minWidth">@dimen/pid_touch_target</item>
    <item name="android:minHeight">@dimen/pid_touch_target</item>
    <item name="android:textAppearance">@style/TextAppearance.PutItDown.Label</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:textColor">@color/pid_on_surface</item>
    <item name="iconTint">@color/pid_on_surface</item>
    <item name="iconSize">@dimen/pid_icon_size</item>
    <item name="icon">@drawable/pid_ic_back</item>
    <item name="iconGravity">textStart</item>
  </style>
  <style name="Widget.PutItDown.Card" parent="Widget.Material3.CardView.Outlined">
    <item name="cardBackgroundColor">@color/pid_surface</item>
    <item name="strokeColor">@color/pid_outline_variant</item>
    <item name="cardCornerRadius">@dimen/pid_card_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="contentPadding">@dimen/pid_card_padding</item>
  </style>
  <style name="Widget.PutItDown.TextField" parent="Widget.Material3.TextInputLayout.OutlinedBox">
    <item name="boxBackgroundColor">@color/pid_surface</item>
    <item name="boxCornerRadiusTopStart">@dimen/pid_button_radius</item>
    <item name="boxCornerRadiusTopEnd">@dimen/pid_button_radius</item>
    <item name="boxCornerRadiusBottomStart">@dimen/pid_button_radius</item>
    <item name="boxCornerRadiusBottomEnd">@dimen/pid_button_radius</item>
  </style>
  <style name="Widget.PutItDown.ListRow" parent="">
    <item name="android:minHeight">@dimen/pid_touch_target</item>
    <item name="android:padding">@dimen/pid_card_padding</item>
    <item name="android:background">?attr/selectableItemBackground</item>
  </style>
  <style name="Widget.PutItDown.ThemeChoice" parent="Widget.Material3.CompoundButton.RadioButton">
    <item name="android:minHeight">@dimen/pid_touch_target</item>
    <item name="android:padding">@dimen/pid_space_md</item>
    <item name="android:background">@drawable/pid_choice_background</item>
    <item name="android:textAppearance">@style/TextAppearance.PutItDown.Label</item>
    <item name="android:drawablePadding">@dimen/pid_space_md</item>
    <item name="android:gravity">center</item>
    <item name="buttonTint">@color/pid_secondary</item>
  </style>
  <style name="TextAppearance.PutItDown.Nav" parent="TextAppearance.PutItDown.Supporting">
    <item name="android:textSize">11sp</item>
  </style>
  <style name="Widget.PutItDown.NavigationIndicator" parent="">
    <item name="android:color">@color/pid_brand_coral</item>
    <item name="android:width">52dp</item>
    <item name="android:height">32dp</item>
    <item name="shapeAppearance">@style/ShapeAppearance_PutItDown</item>
  </style>
  <style name="Widget.PutItDown.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
    <item name="backgroundTint">@color/pid_background</item>
  </style>
  <style name="ThemeOverlay.PutItDown.BottomSheet" parent="ThemeOverlay.Material3.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/Widget.PutItDown.BottomSheet</item>
    <item name="colorSurface">@color/pid_background</item>
  </style>
  <style name="ThemeOverlay.PutItDown.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
    <item name="colorSurface">@color/pid_background</item>
  </style>
</resources>