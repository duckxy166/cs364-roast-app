<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/pid_background">
  <include android:id="@+id/pid_navigation" android:layout_width="88dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" layout="@layout/pid_navigation" />
  <ScrollView android:id="@+id/pid_scroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/pid_navigation">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="560dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_roast_back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pid_back" style="@style/Widget.PutItDown.Button.Back" />
        <TextView android:id="@+id/text_persona_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_title" android:textAppearance="@style/TextAppearance.PutItDown.Heading" android:layout_marginTop="16dp" />
        <TextView android:id="@+id/text_persona_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_description" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginTop="8dp" />
        <TextView android:id="@+id/pid_persona_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_choose" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" android:layout_marginTop="28dp" />
        <RadioGroup android:id="@+id/radio_group_persona" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="4dp">
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/radio_persona_strict" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:layout_marginTop="8dp" android:padding="16dp" android:background="@drawable/pid_choice_background" android:text="@string/pid_persona_strict" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textColor="@color/pid_on_surface" app:buttonTint="@color/pid_secondary" android:gravity="center_vertical" android:drawablePadding="12dp" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/radio_persona_sarcastic" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:layout_marginTop="8dp" android:padding="16dp" android:background="@drawable/pid_choice_background" android:text="@string/pid_persona_sarcastic" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textColor="@color/pid_on_surface" app:buttonTint="@color/pid_secondary" android:gravity="center_vertical" android:drawablePadding="12dp" />
          <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/radio_persona_mom" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="76dp" android:layout_marginTop="8dp" android:padding="16dp" android:background="@drawable/pid_choice_background" android:text="@string/pid_persona_mom" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textColor="@color/pid_on_surface" app:buttonTint="@color/pid_secondary" android:gravity="center_vertical" android:drawablePadding="12dp" />
        </RadioGroup>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/pid_persona_sample_panel" android:background="@drawable/pid_tonal_panel" android:padding="18dp" android:layout_marginTop="16dp">
          <TextView android:id="@+id/pid_persona_sample_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_sample_label" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:textColor="@color/pid_on_secondary_container" />
          <TextView android:id="@+id/text_persona_sample_line" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_sample" android:textAppearance="@style/TextAppearance.PutItDown.Section" android:layout_marginTop="8dp" android:textColor="@color/pid_on_secondary_container" />
          <com.google.android.material.button.MaterialButton android:id="@+id/btn_preview_roast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_sample_next" style="@style/Widget.PutItDown.Button.Back" app:icon="@drawable/pid_ic_refresh" android:textSize="13sp" android:layout_marginTop="8dp" android:gravity="start|center_vertical" />
        </LinearLayout>
        <TextView android:id="@+id/pid_custom_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/roast_custom_section" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" android:layout_marginTop="28dp" />
        <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_layout_custom_roast" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="@string/roast_custom_hint" style="@style/Widget.PutItDown.TextField">
          <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_custom_roast" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="96dp" android:gravity="top|start" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLines="5" android:textAppearance="@style/TextAppearance.PutItDown.Body" />
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_add_custom_roast" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/roast_custom_add_btn" style="@style/Widget.PutItDown.Button.Primary" android:layout_marginTop="12dp" app:icon="@drawable/pid_ic_plus" />
        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/pid_outline_variant" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" />
        <TextView android:id="@+id/pid_custom_list_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_your_lines" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" />
        <TextView android:id="@+id/text_custom_roast_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_persona_empty" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginTop="20dp" android:paddingBottom="20dp" android:gravity="center" />
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_custom_roasts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" />
      </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>