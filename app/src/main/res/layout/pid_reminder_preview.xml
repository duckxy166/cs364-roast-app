<?xml version="1.0" encoding="utf-8"?>
<!-- Reminder preview sheet (ReminderPreviewUi): the notification as it will look, plus its voice line. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="24dp" android:paddingBottom="16dp">
    <TextView android:id="@+id/pid_preview_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_preview_title" android:textAppearance="@style/TextAppearance.PutItDown.Section" />
    <TextView android:id="@+id/pid_preview_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/pid_preview_note" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />

    <!-- Notification card, laid out like the Android shade: round app icon + "app · now" header, then title and text aligned under the header. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/pid_notification_background" android:padding="16dp" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/pid_app_icon_tile" android:importantForAccessibility="no" />
            <TextView android:id="@+id/pid_preview_app" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:text="@string/app_name" android:maxLines="1" android:ellipsize="end" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/pid_preview_now" android:maxLines="1" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <TextView android:id="@+id/pid_preview_counter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
        </LinearLayout>
        <TextView android:id="@+id/pid_preview_notification_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginTop="6dp" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" />
        <TextView android:id="@+id/pid_preview_notification_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="36dp" android:layout_marginTop="2dp" android:textAppearance="@style/TextAppearance.PutItDown.Body" android:accessibilityLiveRegion="polite" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_play" style="@style/Widget.PutItDown.Button.Primary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="@string/pid_preview_play" app:icon="@drawable/pid_ic_play" />
        <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_next" style="@style/Widget.PutItDown.Button.Secondary" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="@dimen/pid_primary_height" android:text="@string/pid_preview_next" />
    </LinearLayout>
    <TextView android:id="@+id/pid_preview_volume" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pid_preview_volume_off" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:textColor="@color/pid_error" android:visibility="gone" android:accessibilityLiveRegion="polite" />

    <TextView android:id="@+id/pid_preview_delivery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
    <com.google.android.material.button.MaterialButton android:id="@+id/pid_preview_close" style="@style/Widget.PutItDown.Button.Back" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/pid_close" app:icon="@null" />
</LinearLayout>
