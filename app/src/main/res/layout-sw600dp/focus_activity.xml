<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fitsSystemWindows="true" android:background="@color/pid_background">
  <include android:id="@+id/pid_navigation" layout="@layout/pid_navigation" android:layout_width="88dp" android:layout_height="0dp" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent" />
  <ScrollView android:id="@+id/pid_scroll" android:layout_width="0dp" android:layout_height="0dp" android:fillViewport="true" android:clipToPadding="false" app:layout_constraintTop_toTopOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintStart_toEndOf="@id/pid_navigation">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="24dp" android:paddingBottom="32dp" app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintWidth_max="560dp">

        <!-- A tab root has no parent to go back to; the system back gesture still works. -->
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_focus_back" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pid_back" android:visibility="gone" />

        <TextView android:id="@+id/text_focus_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_focus_title" android:textAppearance="@style/TextAppearance.PutItDown.Heading" />
        <TextView android:id="@+id/text_focus_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/pid_focus_desc" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textColor="@color/pid_on_surface_variant" />

        <include layout="@layout/pid_focus_feedback" />

        <LinearLayout android:id="@+id/layout_focus_duration_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="24dp">
          <TextView android:id="@+id/pid_duration_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_duration" android:textAppearance="@style/TextAppearance.PutItDown.GroupLabel" />
          <com.google.android.material.textfield.TextInputLayout android:id="@+id/input_layout_focus_minutes" style="@style/Widget.PutItDown.TextField" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:hintEnabled="false">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/edit_focus_minutes" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="3" android:text="@string/focus_default_minutes" android:textSize="22sp" android:textStyle="bold" android:textColor="@color/pid_on_surface" android:fontFeatureSettings="tnum" android:contentDescription="@string/pid_duration" />
          </com.google.android.material.textfield.TextInputLayout>
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_preset_1" style="@style/Widget.PutItDown.Button.Chip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="@string/focus_preset_1_min" android:checkable="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_preset_5" style="@style/Widget.PutItDown.Button.Chip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="@string/focus_preset_5_min" android:checkable="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_preset_15" style="@style/Widget.PutItDown.Button.Chip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginEnd="8dp" android:text="@string/focus_preset_15_min" android:checkable="true" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btn_preset_25" style="@style/Widget.PutItDown.Button.Chip" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/focus_preset_25_min" android:checkable="true" />
          </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/pid_timer_container" android:layout_width="232dp" android:layout_height="232dp" android:orientation="vertical" android:layout_marginTop="28dp" android:layout_marginBottom="8dp" android:layout_gravity="center" android:gravity="center" android:background="@drawable/pid_timer_ring" android:visibility="gone">
          <TextView android:id="@+id/text_focus_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:gravity="center" android:text="@string/focus_status_ready" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
          <TextView android:id="@+id/text_focus_timer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:maxLines="1" android:text="@string/focus_default_timer" android:textAppearance="@style/TextAppearance.PutItDown.Timer" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="28sp" android:autoSizeMaxTextSize="48sp" android:autoSizeStepGranularity="1sp" />
          <TextView android:id="@+id/pid_timer_caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/pid_keep_open" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btn_focus_start" style="@style/Widget.PutItDown.Button.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/pid_start_focus" app:icon="@drawable/pid_ic_play" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_focus_abandon" style="@style/Widget.PutItDown.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="@string/pid_end_focus" android:visibility="gone" />
        <TextView android:id="@+id/pid_focus_note" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/pid_focus_note" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="32dp">
          <TextView android:id="@+id/text_focus_history_header" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/pid_completed" android:textAppearance="@style/TextAppearance.PutItDown.GroupLabel" />
          <TextView android:id="@+id/text_focus_completed_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/focus_history_empty" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
        </LinearLayout>
        <TextView android:id="@+id/text_focus_history_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="16dp" android:background="@drawable/pid_card_background" android:text="@string/focus_history_empty" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textColor="@color/pid_on_surface_variant" android:lineSpacingExtra="4dp" />
      </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
