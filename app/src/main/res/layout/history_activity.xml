<com.google.android.material.button.MaterialButton android:id="@+id/history_daily_toggle" style="@style/Widget.PutItDown.Button.Back" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_daily_show" android:gravity="start|center_vertical" app:icon="@drawable/pid_ic_chevron" app:iconGravity="end" />
<LinearLayout android:id="@+id/history_daily_values" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
<com.google.android.material.button.MaterialButton android:id="@+id/history_usage_action" style="@style/Widget.PutItDown.Button.Secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_usage_retry" android:visibility="gone" android:layout_marginTop="12dp" />
</LinearLayout></com.google.android.material.card.MaterialCardView>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="28dp">
<TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/history_events_section" android:textAppearance="@style/TextAppearance.PutItDown.Section" />
<com.google.android.material.button.MaterialButton android:id="@+id/btn_history_clear_all" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/history_clear_all_btn" app:icon="@null" android:textColor="@color/pid_error" /></LinearLayout>
<LinearLayout android:id="@+id/layout_history_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:paddingTop="24dp" android:paddingBottom="24dp">
<ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:src="@drawable/pid_ic_bell" android:background="@drawable/pid_tonal_panel" app:tint="@color/pid_on_secondary_container" android:importantForAccessibility="no" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/history_empty" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:gravity="center" android:layout_marginTop="12dp" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_history_empty_note" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:gravity="center" android:layout_marginTop="8dp" />
<com.google.android.material.button.MaterialButton android:id="@+id/history_empty_apps" style="@style/Widget.PutItDown.Button.Back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/review_choose_apps" app:icon="@drawable/pid_ic_chevron" app:iconGravity="textEnd" android:layout_marginTop="12dp" />
</LinearLayout>
<androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler_history_events" android:layout_width="match_parent" android:layout_height="wrap_content" android:nestedScrollingEnabled="false" android:layout_marginTop="12dp" /></LinearLayout></androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView></androidx.constraintlayout.widget.ConstraintLayout>