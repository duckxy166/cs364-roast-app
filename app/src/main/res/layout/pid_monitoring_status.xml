<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:id="@+id/pid_monitoring_panel" android:background="@drawable/pid_tonal_panel" android:padding="16dp" android:layout_marginTop="20dp" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/pid_monitor_icon" android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/pid_ic_permission" app:tint="@color/pid_on_secondary_container" android:importantForAccessibility="no" />
        <TextView android:id="@+id/pid_monitor_title" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/pid_monitor_missing" android:textAppearance="@style/TextAppearance.PutItDown.Label" android:textStyle="bold" android:layout_marginStart="10dp" android:layout_weight="1" />
    </LinearLayout>
    <TextView android:id="@+id/pid_monitor_description" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/pid_monitor_missing_desc" android:textAppearance="@style/TextAppearance.PutItDown.Supporting" android:layout_marginTop="6dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/btn_nav_onboarding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/pid_monitor_check" style="@style/Widget.PutItDown.Button.Secondary" android:layout_marginTop="10dp" />
</LinearLayout>