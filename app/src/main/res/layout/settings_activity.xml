<?xml version='1.0' encoding='utf-8'?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/pid_background">
  <include
      android:id="@+id/pid_navigation"
      layout="@layout/pid_navigation"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      app:layout_constraintBottom_toBottomOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />
  <ScrollView
      android:id="@+id/pid_scroll"
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:fillViewport="true"
      android:clipToPadding="false"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toTopOf="@id/pid_navigation"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">
    <androidx.constraintlayout.widget.ConstraintLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="24dp"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintWidth_max="560dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pid_back"
            style="@style/Widget.PutItDown.Button.Back"
            android:layout_marginBottom="16dp" />
        <TextView
            android:id="@+id/text_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pid_settings"
            android:textAppearance="@style/TextAppearance.PutItDown.Heading" />
        <TextView
            android:id="@+id/text_settings_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pid_settings_desc"
            android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
            android:layout_marginTop="8dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/container_settings_language"
            android:layout_marginTop="26dp">
          <LinearLayout
              android:id="@+id/pid_language_row"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:minHeight="64dp"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:background="?attr/selectableItemBackground"
              android:clickable="true"
              android:focusable="true">
            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:padding="8dp"
                android:background="@drawable/pid_soft_icon_background"
                android:src="@drawable/pid_ic_globe"
                android:importantForAccessibility="no" />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/pid_app_language"
                android:textAppearance="@style/TextAppearance.PutItDown.Label" />
            <TextView
                android:id="@+id/pid_current_language"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="12dp"
                android:src="@drawable/pid_ic_chevron"
                android:importantForAccessibility="no" />
          </LinearLayout>
          <RadioGroup
              android:id="@+id/radio_group_language"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:visibility="gone">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radio_lang_th"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/settings_language_thai" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radio_lang_en"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="@string/settings_language_english" />
          </RadioGroup>
          <TextView
              android:id="@+id/text_settings_language_header"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/pid_language"
              android:textAppearance="@style/TextAppearance.PutItDown.Label"
              android:visibility="gone" />
          <TextView
              android:id="@+id/text_settings_language_desc"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/pid_language"
              android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
              android:visibility="gone" />
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/pid_outline_variant"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/container_settings_theme">
          <TextView
              android:id="@+id/text_settings_theme_header"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/pid_appearance"
              android:textAppearance="@style/TextAppearance.PutItDown.Label"
              android:textStyle="bold" />
          <TextView
              android:id="@+id/text_settings_theme_desc"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/pid_appearance_desc"
              android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
              android:layout_marginTop="4dp"
              android:visibility="gone" />
          <RadioGroup
              android:id="@+id/radio_group_theme"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_marginTop="13dp">
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radio_theme_day"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:padding="8dp"
                android:button="@null"
                app:buttonCompat="@null"
                android:gravity="center"
                android:drawableTop="@drawable/pid_theme_day_preview"
                android:drawablePadding="12dp"
                android:minHeight="132dp"
                android:background="@drawable/pid_choice_background"
                android:text="@string/pid_light"
                android:textAppearance="@style/TextAppearance.PutItDown.Label"
                android:textColor="@color/pid_on_surface" />
            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radio_theme_night"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:padding="8dp"
                android:button="@null"
                app:buttonCompat="@null"
                android:gravity="center"
                android:drawableTop="@drawable/pid_theme_night_preview"
                android:drawablePadding="12dp"
                android:minHeight="132dp"
                android:background="@drawable/pid_choice_background"
                android:text="@string/pid_dark"
                android:textAppearance="@style/TextAppearance.PutItDown.Label"
                android:textColor="@color/pid_on_surface" />
          </RadioGroup>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/container_settings_demo"
            android:layout_marginTop="27dp">
          <TextView
              android:id="@+id/text_settings_demo_header"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/pid_reminders"
              android:textAppearance="@style/TextAppearance.PutItDown.Label"
              android:textStyle="bold" />
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:background="@drawable/pid_card_background"
              android:padding="16dp"
              android:layout_marginTop="12dp">
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switch_demo_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/pid_demo"
                android:textAppearance="@style/TextAppearance.PutItDown.Label" />
            <TextView
                android:id="@+id/text_settings_demo_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pid_demo_desc"
                android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
                android:layout_marginTop="4dp" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/pid_outline_variant"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp" />
            <TextView
                android:id="@+id/pid_schedule_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pid_schedule_normal"
                android:textAppearance="@style/TextAppearance.PutItDown.Supporting" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/pid_thresholds_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pid_show_thresholds"
                style="@style/Widget.PutItDown.Button.Back"
                app:icon="@drawable/pid_ic_chevron"
                app:iconGravity="textEnd"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/text_settings_thresholds_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_thresholds_summary_normal"
                android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
                android:visibility="gone" />
          </LinearLayout>
        </LinearLayout>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/pid_reminder_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pid_reminder_preview"
            style="@style/Widget.PutItDown.Button.Back"
            app:icon="@drawable/pid_ic_chevron"
            app:iconGravity="textEnd"
            android:gravity="start|center_vertical"
            android:layout_marginTop="8dp" />
      </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>