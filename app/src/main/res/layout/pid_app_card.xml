<?xml version="1.0" encoding="utf-8"?>
<!-- Editable usage row for the Apps tab: same anatomy as pid_app_summary plus two quiet icon actions. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:gravity="center_vertical">
    <ImageView
        android:id="@+id/pid_app_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/pid_ic_apps"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/pid_app_name"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/pid_app_placeholder"
        android:textAppearance="@style/TextAppearance.PutItDown.Body"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        tools:text="Instagram" />
    <ImageButton
        android:id="@+id/pid_app_edit"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/pid_ic_edit"
        android:contentDescription="@string/pid_edit_limit"
        app:tint="@color/pid_on_surface_variant" />
    <ImageButton
        android:id="@+id/pid_app_remove"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="-12dp"
        android:padding="13dp"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/pid_ic_trash"
        android:contentDescription="@string/pid_remove"
        app:tint="@color/pid_on_surface_variant" />
  </LinearLayout>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:layout_marginStart="48dp">
    <TextView
        android:id="@+id/pid_app_usage"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:text="@string/pid_usage_pending"
        android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
        tools:text="18 / 30 นาที" />
    <TextView
        android:id="@+id/pid_app_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:text="@string/pid_usage_pending"
        android:textAppearance="@style/TextAppearance.PutItDown.Supporting"
        tools:text="เหลือ 12 นาที" />
  </LinearLayout>
  <ProgressBar
      android:id="@+id/pid_app_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginStart="48dp"
      android:layout_marginTop="8dp"
      android:max="100"
      android:progress="0"
      android:progressDrawable="@drawable/pid_progress_track"
      tools:progress="60" />
</LinearLayout>
